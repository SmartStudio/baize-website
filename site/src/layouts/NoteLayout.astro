---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import RelatedNotes from '../components/notes/RelatedNotes.astro';
import { categoryLabel } from '../lib/notes';
import { localePath, withBase } from '../lib/i18n';
import { orgRef } from '../lib/organization';
import type { FaqItem } from '../lib/faq';

interface Props {
  title: string;
  seoTitle?: string;
  seoDescription?: string;
  description: string;
  lang?: 'zh-CN' | 'en';
  alternates: { hreflang: string; path: string }[];
  switchPath?: string;
  pubDate: Date;
  updatedDate?: Date;
  category: CollectionEntry<'notes'>['data']['category'];
  author: string;
  relatedService?: string;
  ctaVariant?: 'consulting' | 'api';
  howto?: { name: string; steps: { name: string; text: string }[] };
  faq?: FaqItem[];
  cover?: ImageMetadata;
  coverAlt?: string;
  path: string;
  related?: CollectionEntry<'notes'>[];
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  seoTitle,
  seoDescription,
  description,
  lang = 'zh-CN',
  alternates,
  switchPath,
  pubDate,
  updatedDate,
  category,
  author,
  relatedService,
  ctaVariant = 'consulting',
  howto,
  faq = [],
  cover,
  coverAlt,
  path,
  related = [],
  headings = [],
} = Astro.props;
// 目录只收 h2;少于 3 节不值得占一列,直接不出。
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;
const base = import.meta.env.BASE_URL;
const site = import.meta.env.SITE;
const canonical = new URL(path, site).href;
const isEnglish = lang === 'en';
const displayCategory = categoryLabel(category, lang);
const homePath = localePath('/', lang);
const notesPath = localePath('/notes/', lang);

const dateStr = pubDate.toLocaleDateString(isEnglish ? 'en-US' : 'zh-CN', {
  year: 'numeric',
  month: isEnglish ? 'long' : '2-digit',
  day: '2-digit',
});

// ---- 社交预览图 ----
// 每篇笔记都有 guizang 出的封面,但此前 og:image 一直是站点默认图,封面只在页面里
// 露过面——分享到微信/Twitter/飞书全都退化成同一张通用图。这里把它接上。
//
// 两个刻意的选择:
//   1. 导 JPEG 而不是复用页面的 WebP:Twitter 认 WebP,但微信/飞书这类抓取器支持不稳,
//      会直接不显示图。页面继续用 WebP 省流量,社交预览单独走 JPEG。
//   2. 只锁 width 不锁 height:源图是 16:9,强行裁到 1200×630 会切掉画面上下沿。
//      1200×675 在 Facebook/微信/Twitter 都能正常出大图卡片。
const ogAsset = cover ? await getImage({ src: cover, width: 1200, format: 'jpeg', quality: 80 }) : null;
// getImage 的 src 带 base 前缀(GH 镜像下是 /baize-website/...),但 OG 图必须指向
// CF 主站的资源(镜像 noindex、canonical 也指主站),所以去掉 base 再交给 Seo 拼域名。
const ogImage = ogAsset ? '/' + ogAsset.src.slice(base.length) : undefined;
const ogImageAbs = ogImage ? new URL(ogImage, site).href : undefined;

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  datePublished: pubDate.toISOString(),
  // Google 建议 dateModified 始终存在;没改过就等于发布时间。
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Organization', name: author, url: new URL(homePath, site).href },
  publisher: orgRef(lang),
  // 没有 image 就拿不到文章富媒体的大图卡片,只会是纯文字结果。
  ...(ogImageAbs ? { image: [ogImageAbs] } : {}),
  articleSection: displayCategory,
  inLanguage: lang,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: isEnglish ? 'Home' : '首页', item: new URL(homePath, site).href },
    { '@type': 'ListItem', position: 2, name: isEnglish ? 'Notes' : '明理笔记', item: new URL(notesPath, site).href },
    // 末项是当前页,按规范不再给 item。
    { '@type': 'ListItem', position: 3, name: title },
  ],
};

const howToLd = howto
  ? {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: howto.name,
      description,
      step: howto.steps.map((s, i) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: s.name,
        text: s.text,
      })),
    }
  : null;

const faqLd = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: lang,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

const jsonLd = [blogLd, breadcrumbLd, ...(howToLd ? [howToLd] : []), ...(faqLd ? [faqLd] : [])];

// relatedService 比现行四项服务分得细,这里把它映射到服务页对应服务的锚点。
const SERVICE_CTA: Record<string, { label: string; anchor: string }> = {
  consulting: { label: 'AI 转型咨询', anchor: '#consulting' },
  'dev-workflow': { label: 'AI 研发流设计', anchor: '#fde' },
  'loop-engineering': { label: 'Loop Engineering 设计', anchor: '#fde' },
  delivery: { label: '想法到产品端到端交付', anchor: '#fde' },
  gateway: { label: 'LLM API 网关设计', anchor: '#tools' },
};
const serviceCta = (relatedService && SERVICE_CTA[relatedService]) || { label: 'AI 工作流', anchor: '' };
const isApiArticle = isEnglish && ctaVariant === 'api';
const cta = isApiArticle
  ? {
      eyebrow: 'START BUILDING',
      title: 'Run your first model call with $10 in starter credit.',
      body: 'Create an API key, choose a live model ID, and keep your existing OpenAI SDK code.',
      primaryLabel: 'Create an account',
      primaryHref: 'https://api.fxai.ai/sign-up',
      secondaryLabel: 'Compare models and pricing',
      secondaryHref: 'https://api.fxai.ai/models',
    }
  : isEnglish
    ? {
        eyebrow: 'NEXT STEP',
        title: 'Bring a reliable AI workflow into your team.',
        body: 'Remote-first AI transformation: consulting, team training, forward deployed engineering, and internal tools.',
        primaryLabel: 'Book a consultation',
        primaryHref: withBase(base, '/en/contact/'),
        secondaryLabel: 'View services',
        secondaryHref: withBase(base, '/en/services/'),
      }
    : {
        eyebrow: '下一步',
        title: `想把「${serviceCta.label}」落到你的团队？`,
        body: '白泽明理提供 AI 转型咨询、企业 AI 培训、FDE 驻场开发、工具开发与产品支持四项服务。先用 30 分钟免费诊断，找出第一条该改的流程。',
        primaryLabel: '预约咨询',
        primaryHref: `${base}contact/`,
        secondaryLabel: '查看服务详情',
        secondaryHref: `${base}services/${serviceCta.anchor}`,
      };
---
<BaseLayout
  title={seoTitle ?? title}
  description={seoDescription ?? description}
  path={path}
  jsonLd={jsonLd}
  ogImage={ogImage}
  ogImageAlt={coverAlt ?? title}
  ogType="article"
  article={{
    published: pubDate.toISOString(),
    modified: (updatedDate ?? pubDate).toISOString(),
    section: displayCategory,
    author,
  }}
  lang={lang}
  alternates={alternates}
  switchPath={switchPath}
>
  <article class="bz-art">
    <header class="bz-art__head">
      <nav class="bz-art__crumbs" aria-label={isEnglish ? 'Breadcrumb' : '面包屑'}>
        <a href={withBase(base, homePath)}>{isEnglish ? 'Home' : '首页'}</a>
        <span aria-hidden="true">/</span>
        <a href={withBase(base, notesPath)}>{isEnglish ? 'Notes' : '明理笔记'}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{isEnglish ? 'This note' : '本文'}</span>
      </nav>
      <p class="bz-art__chips"><span class="bz-art__chip">{displayCategory}</span></p>
      <h1 class="bz-art__title">{title}</h1>
      <p class="bz-art__lead">{description}</p>
      <p class="bz-art__meta">
        <span>{author}</span>
        <time datetime={pubDate.toISOString()}>{dateStr}</time>
      </p>
    </header>

    {cover && (
      <div class="bz-art__wide">
        <figure class="bz-art__cover">
          <Image src={cover} alt={coverAlt ?? title} class="bz-art__cover-img" widths={[760, 1120, 1680]} sizes="(max-width: 1184px) 100vw, 1120px" loading="eager" fetchpriority="high" />
        </figure>
      </div>
    )}

    <div class:list={['bz-art__wide', 'bz-art__grid', { 'bz-art__grid--toc': showToc }]}>
      {showToc && (
        <aside class="bz-art__toc" aria-label={isEnglish ? 'Contents' : '目录'}>
          <p class="bz-art__toc-label">{isEnglish ? 'Contents' : '目录'}</p>
          <ol>
            {toc.map((h) => (
              <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
            ))}
          </ol>
        </aside>
      )}

      <div class="bz-art__main">
        <div class="bz-note__body">
          <slot />
        </div>

        <aside class="bz-art__cta" aria-label={cta.eyebrow}>
          <div class="bz-art__cta-copy">
            <p class="bz-art__cta-eyebrow">{cta.eyebrow}</p>
            <p class="bz-art__cta-title">{cta.title}</p>
            <p class="bz-art__cta-body">{cta.body}</p>
          </div>
          <div class="bz-art__cta-actions">
            <a class="bz-art__pill" href={cta.primaryHref}>{cta.primaryLabel} →</a>
            <a class="bz-art__cta-link" href={cta.secondaryHref}>{cta.secondaryLabel}</a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <RelatedNotes notes={related} lang={lang} />

  <div id="bz-lightbox" class="bz-lightbox" role="dialog" aria-modal="true" aria-label={isEnglish ? 'View enlarged image' : '放大查看图片'} hidden>
    <button type="button" class="bz-lightbox__close" aria-label={isEnglish ? 'Close' : '关闭'}>✕</button>
    <img class="bz-lightbox__img" src="" alt="" />
    <p class="bz-lightbox__cap" hidden></p>
  </div>
</BaseLayout>

<script>
  // 点击正文里带 data-zoomable 的图 → 放大到全屏 lightbox。渐进增强:无 JS 时图片照常显示。
  const overlay = document.getElementById('bz-lightbox');
  if (overlay) {
    const overlayImg = overlay.querySelector('.bz-lightbox__img') as HTMLImageElement;
    const overlayCap = overlay.querySelector('.bz-lightbox__cap') as HTMLElement;
    const closeBtn = overlay.querySelector('.bz-lightbox__close') as HTMLElement;
    let lastFocus: HTMLElement | null = null;

    const open = (img: HTMLImageElement) => {
      const cap = img.closest('figure')?.querySelector('.bz-figcap')?.textContent ?? '';
      overlayImg.src = img.currentSrc || img.src;
      overlayImg.alt = img.alt;
      overlayCap.textContent = cap;
      overlayCap.hidden = !cap;
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      lastFocus = document.activeElement as HTMLElement;
      closeBtn.focus();
    };

    const close = () => {
      overlay.hidden = true;
      overlayImg.removeAttribute('src');
      document.body.style.overflow = '';
      lastFocus?.focus?.();
    };

    document.querySelectorAll<HTMLImageElement>('.bz-note__body [data-zoomable]').forEach((img) => {
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', () => open(img));
    });

    overlay.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === overlay || t.closest('.bz-lightbox__close')) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hidden) close();
    });
  }

  // 目录高亮当前所读的 h2。渐进增强:无 JS 时目录就是普通锚点列表。
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.bz-art__toc a[data-toc]'));
  if (tocLinks.length && 'IntersectionObserver' in window) {
    const ids = new Set(tocLinks.map((a) => a.dataset.toc));
    const setActive = (id: string) => tocLinks.forEach((a) => a.classList.toggle('is-active', a.dataset.toc === id));
    const io = new IntersectionObserver(
      (entries) => {
        const hit = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (hit && ids.has(hit.target.id)) setActive(hit.target.id);
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    ids.forEach((id) => {
      const el = id ? document.getElementById(id) : null;
      if (el) io.observe(el);
    });
  }
</script>

<style>
  /* ---------- 白泽青 v3 文章骨架 ----------
     头部 860 窄列;封面与正文网格 1120;正文阅读列 ≤720。 */
  .bz-art {
    --art-gutter: clamp(16px, 4vw, 32px);
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .bz-art__head {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(28px, 4vw, 40px) var(--art-gutter);
  }

  .bz-art__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: clamp(24px, 4vw, 40px);
    color: var(--bz-text-secondary);
    font-size: 14px;
  }

  .bz-art__crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .bz-art__crumbs a:hover {
    color: var(--bz-accent-strong);
  }

  .bz-art__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 20px;
  }

  .bz-art__chip {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--bz-chip);
    color: var(--bz-accent-strong);
    font-size: 13px;
    font-weight: 600;
  }

  .bz-art__title {
    margin: 0;
    color: var(--bz-text-primary);
    font-family: var(--bz-font-display);
    font-size: clamp(30px, 4.6vw, 52px);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }

  .bz-art__lead {
    margin: 24px 0 0;
    color: var(--bz-ink-700);
    font-size: clamp(17px, 1.6vw, 19px);
    line-height: 1.7;
  }

  .bz-art__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin: 24px 0 0;
    color: var(--bz-text-secondary);
    font-size: 14px;
  }

  .bz-art__meta span::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--bz-accent);
    vertical-align: 1px;
  }

  .bz-art__wide {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 var(--art-gutter);
  }

  .bz-art__cover {
    margin: 0;
  }

  .bz-art__cover-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
    background: var(--bz-dark);
  }

  .bz-art__grid {
    padding-top: clamp(40px, 5vw, 64px);
  }

  .bz-art__main {
    max-width: 720px;
    min-width: 0;
    margin: 0 auto;
  }

  .bz-art__toc {
    display: none;
  }

  @media (min-width: 1100px) {
    .bz-art__grid--toc {
      display: grid;
      grid-template-columns: 220px minmax(0, 720px);
      justify-content: space-between;
      gap: 56px;
      align-items: start;
    }

    .bz-art__grid--toc .bz-art__main {
      margin: 0;
    }

    .bz-art__toc {
      display: block;
      position: sticky;
      top: 96px;
      max-height: calc(100vh - 120px);
      overflow-y: auto;
      font-size: 14px;
    }

    /* 有目录时正文列不再居中,wide/full 图收回列宽,免得盖住目录 */
    .bz-art__grid--toc :global(.bz-media--wide),
    .bz-art__grid--toc :global(.bz-media--full) {
      left: auto;
      transform: none;
      width: 100%;
    }
  }

  .bz-art__toc-label {
    margin: 0 0 12px;
    color: var(--bz-text-secondary);
    font-weight: 600;
  }

  .bz-art__toc ol {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bz-art__toc a {
    display: block;
    padding: 8px 14px;
    border-radius: 10px;
    color: var(--bz-text-secondary);
    line-height: 1.5;
    text-decoration: none;
    transition: background var(--bz-transition-fast), color var(--bz-transition-fast);
  }

  .bz-art__toc a:hover {
    color: var(--bz-text-primary);
  }

  .bz-art__toc a.is-active {
    background: var(--bz-chip);
    color: var(--bz-accent-strong);
    font-weight: 600;
  }

  .bz-art__toc a:focus-visible,
  .bz-art__crumbs a:focus-visible,
  .bz-art__pill:focus-visible,
  .bz-art__cta-link:focus-visible {
    outline: 3px solid var(--bz-focus-ring);
    outline-offset: 2px;
  }

  /* ---------- 正文排版 ---------- */
  .bz-note__body :global(p) {
    margin: 0 0 24px;
    color: var(--bz-ink-700);
    font-size: 17px;
    line-height: 1.9;
  }

  .bz-note__body :global(h2) {
    margin: 56px 0 16px;
    color: var(--bz-text-primary);
    font-family: var(--bz-font-display);
    font-size: clamp(23px, 2.4vw, 28px);
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: -0.01em;
    scroll-margin-top: 96px;
  }

  .bz-note__body > :global(h2:first-child) {
    margin-top: 0;
  }

  .bz-note__body :global(h3) {
    margin: 36px 0 12px;
    color: var(--bz-text-primary);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.4;
    scroll-margin-top: 96px;
  }

  .bz-note__body :global(ul),
  .bz-note__body :global(ol) {
    margin: 0 0 24px;
    padding-left: 22px;
    color: var(--bz-ink-700);
    font-size: 17px;
    line-height: 1.9;
  }

  .bz-note__body :global(li::marker) {
    color: var(--bz-accent-strong);
  }

  .bz-note__body :global(strong) {
    color: var(--bz-text-primary);
  }

  .bz-note__body :global(a) {
    color: var(--bz-accent-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* ---------- Rich media ----------
     Global on purpose: shared by Figure/Video/Figures MDX components. */
  :global(.bz-media) {
    margin: clamp(32px, 4vw, 44px) 0;
  }

  :global(.bz-media__img),
  :global(.bz-media__video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
    background: var(--bz-soft);
  }

  :global(.bz-media--border .bz-media__img),
  :global(.bz-media--border .bz-media__video) {
    border: 1px solid var(--bz-border-subtle);
  }

  :global(.bz-media--content) {
    width: 100%;
  }

  :global(.bz-media--wide),
  :global(.bz-media--full) {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }

  :global(.bz-media--wide) {
    width: min(1040px, calc(100vw - var(--bz-page-gutter) * 2));
  }

  :global(.bz-media--full) {
    width: min(1120px, calc(100vw - var(--bz-page-gutter) * 2));
  }

  :global(.bz-media--bleed) {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    max-width: 100vw;
  }

  :global(.bz-media--bleed .bz-media__img),
  :global(.bz-media--bleed .bz-media__video) {
    border-radius: 0;
  }

  :global(.bz-media--bleed .bz-figcap) {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
    padding: 0 var(--bz-page-gutter);
  }

  :global(.bz-figcap) {
    margin: 12px 0 0;
    color: var(--bz-text-muted);
    font-size: 14px;
    line-height: 1.55;
    text-align: center;
  }

  :global(.bz-figures) {
    display: grid;
    gap: clamp(10px, 1.6vw, 16px);
  }

  :global(.bz-figures--2) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  :global(.bz-figures--3) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  :global(.bz-figures .bz-media) {
    margin: 0;
  }

  :global(.bz-figures .bz-figcap) {
    text-align: left;
  }

  @media (max-width: 640px) {
    :global(.bz-figures--2),
    :global(.bz-figures--3) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Callout ---------- */
  :global(.bz-callout) {
    margin: 32px 0;
    border-left: 4px solid var(--bz-accent);
    border-radius: 0 16px 16px 0;
    background: var(--bz-soft);
    padding: 22px 26px;
  }

  :global(.bz-callout--note) {
    border-left-color: var(--bz-on-dark-muted);
    background: var(--bz-gray-100);
  }

  :global(.bz-callout--warning) {
    border-left-color: var(--bz-dark);
    background: var(--bz-chip);
  }

  :global(.bz-callout__title) {
    margin: 0 0 6px;
    color: var(--bz-accent-strong);
    font-size: 14px;
    font-weight: 700;
  }

  :global(.bz-callout--warning .bz-callout__title) {
    color: var(--bz-dark);
  }

