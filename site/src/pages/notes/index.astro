---
import { getCollection } from 'astro:content';
import NotesIndex from '../../components/pages/NotesIndex.astro';
import { alternates, localePath, pairNotes } from '../../lib/i18n';

const { zh } = pairNotes(await getCollection('notes'));
// 列表页两种语言都恒有,所以恒配对。
const zhPath = localePath('/notes/', 'zh-CN');
const enPath = localePath('/notes/', 'en');
---
<NotesIndex lang="zh-CN" notes={[...zh.values()]} alternates={alternates(zhPath, enPath)} switchPath={enPath} />
