---
import Contact from '../components/pages/Contact.astro';
import { zh } from '../i18n/contact';
import { alternates, localePath } from '../lib/i18n';

const zhPath = localePath('/contact/', 'zh-CN');
const enPath = localePath('/contact/', 'en');
---
<Contact lang="zh-CN" copy={zh} alternates={alternates(zhPath, enPath)} switchPath={enPath} />
