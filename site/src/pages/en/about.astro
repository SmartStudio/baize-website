---
import About from '../../components/pages/About.astro';
import { en } from '../../i18n/about';
import { alternates, localePath } from '../../lib/i18n';

const zhPath = localePath('/about/', 'zh-CN');
const enPath = localePath('/about/', 'en');
---
<About lang="en" copy={en} alternates={alternates(zhPath, enPath)} switchPath={zhPath} />
