---
import Method from '../components/pages/Method.astro';
import { zh } from '../i18n/method';
import { alternates, localePath } from '../lib/i18n';

const zhPath = localePath('/method/', 'zh-CN');
const enPath = localePath('/method/', 'en');
---
<Method lang="zh-CN" copy={zh} alternates={alternates(zhPath, enPath)} switchPath={enPath} />
