---
import Services from '../components/pages/Services.astro';
import { zh } from '../i18n/services';
import { alternates, localePath } from '../lib/i18n';

const zhPath = localePath('/services/', 'zh-CN');
const enPath = localePath('/services/', 'en');
---
<Services lang="zh-CN" copy={zh} alternates={alternates(zhPath, enPath)} switchPath={enPath} />
