---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

type Item = { t: string; d: string; out: string };
type Service = { id: string; n: string; t: string; lead: string; items: Item[] };

const SERVICES: Service[] = [
  {
    id: 'consulting',
    n: '01',
    t: 'AI 转型咨询',
    lead: '访谈各部门，排出改造优先级和验收口径。管理层拿到一份能拍板的清单。',
    items: [
      { t: '现状诊断', d: '访谈管理层、业务和技术团队，记录现在怎么用 AI、卡在哪一步。', out: '诊断报告 + 风险边界' },
      { t: '流程优先级', d: '按收益、风险、改造成本给候选流程排序，选出第一条先改的流程。', out: '改造清单 + 推进节奏' },
      { t: '验收口径', d: '每条流程写清改造前后用什么指标对比、谁来签字。', out: '验收标准 + 复盘模板' },
    ],
  },
  {
    id: 'training',
    n: '02',
    t: '企业 AI 培训',
    lead: '按岗位授课，用学员自己的真实任务练习。课后每个团队留下可复用的 Skill。',
    items: [
      { t: '岗位课程', d: '管理层、业务、研发分开排课，内容对应各自每天的工作。', out: '形式 · 企业内训 / 随工工作坊' },
      { t: 'AI 编程实训', d: '从工具使用推进到真实项目工作流：需求、实现、测试、评审。', out: '形式 · 项目制练习' },
      { t: 'Skills 沉淀', d: '把团队规范、业务经验写成 AI Skills，留在你的组织里。', out: '输出 · Skills / SOP / 上下文' },
    ],
  },
  {
    id: 'fde',
    n: '03',
    t: 'FDE 驻场开发',
    lead: '工程师进你的团队，把 Agent 接进 CRM、ERP、HR。研发流程同步改造。',
    items: [
      { t: 'AI 研发流设计', d: '把 AI 编程纳入需求、实现、测试、评审、文档的日常流程。', out: '研发 SOP + 使用规范 + 验收标准' },
      { t: 'Loop Engineering 设计', d: '让 AI 先自查再交付，每一轮按评估结果修正。', out: '回路架构 + 评估体系 + 可复用模板' },
      { t: '想法到产品端到端交付', d: '从想法到可用产品排出路线图，每一步都能验收。', out: '交付蓝图 + 里程碑 + 验收标准' },
    ],
  },
  {
    id: 'tools',
    n: '04',
    t: '工具开发与产品支持',
    lead: '定制内部工具，上线后持续维护。先从 AI 的统一接入做起。',
    items: [
      { t: 'Codex 中转站搭建', d: '给团队一个稳定、可控、可审计的 Codex 使用入口，不用各自找账号。', out: '接入架构 + 权限规则 + 落地指导' },
      { t: 'LLM API 网关设计', d: '所有 AI 调用走统一入口：鉴权、路由、限流、成本和审计一处管理。', out: '网关蓝图 + 路由降级策略 + 审计设计' },
      { t: '内部工具与维护', d: '按业务需要开发内部工具，上线后跟进问题和迭代。', out: '工具交付 + 运维支持' },
    ],
  },
];

const STEPS = [
  { k: '01', t: '先诊断', d: '30 分钟免费沟通，确认现状和第一条要改的流程。' },
  { k: '02', t: '给方案', d: '交付架构、SOP 和验收标准，管理层据此决定是否推进。' },
  { k: '03', t: '带落地', d: '培训、驻场或工具开发，按里程碑验收，方法沉淀成 Skills。' },
];

const jsonLd = SERVICES.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.t,
  description: s.lead,
  provider: { '@type': 'Organization', name: '白泽明理' },
}));
---

<BaseLayout
  title="服务｜AI 转型咨询、企业 AI 培训、FDE 驻场开发与工具开发"
  description="白泽明理四项服务：AI 转型咨询排出改造优先级，企业 AI 培训按岗位授课，FDE 工程师驻场把 Agent 接进业务系统，工具开发覆盖中转站、LLM 网关与内部工具。"
  path="/services/"
  jsonLd={jsonLd}
>
  <section class="hero wrap">
    <p class="badge"><span class="dot"></span>四项服务 · 咨询 · 培训 · FDE · 工具</p>
    <h1>从想清楚，<br />到 <em>跑起来</em>。</h1>
    <p class="hero__sub">先找出最该改的流程，再教团队用 AI 干活，最后派工程师把 Agent 和工具接进你的系统。四项服务可以单独买，也可以按顺序接。</p>
    <nav class="jump" aria-label="服务目录">
      {SERVICES.map((s) => (
        <a href={`#${s.id}`}><span>{s.n}</span>{s.t}</a>
      ))}
    </nav>
  </section>

  {SERVICES.map((s, i) => (
    <section id={s.id} class={i % 2 === 0 ? 'soft' : ''}>
      <div class="wrap sec svc">
        <div class="svc__head">
          <span class="svc__n">{s.n}</span>
          <h2>{s.t}</h2>
          <p class="svc__lead">{s.lead}</p>
        </div>
        <div class="items">
          {s.items.map((it) => (
            <article class="item">
              <h3>{it.t}</h3>
              <p>{it.d}</p>
              <span class="item__out">{it.out}</span>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="dark">
    <div class="wrap sec">
      <p class="eyebrow eyebrow--on-dark">怎么合作</p>
      <h2>三步，每一步都能停</h2>
      <div class="steps">
        {STEPS.map((s) => (
          <div class="step">
            <span class="step__k">{s.k}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap book-wrap">
    <div class="book">
      <div>
        <h2>先聊 30 分钟，<br />找出第一条该改的流程。</h2>
        <p>不收费。也可以微信扫页脚二维码直接聊。</p>
      </div>
      <a class="bz-button bz-button--dark bz-button--lg pill" href={`${base}contact/`}>预约咨询 →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap { max-width: 1240px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .sec { padding-top: 96px; padding-bottom: 96px; }
  h1 { margin: 0; font-weight: 900; font-size: clamp(40px, 5vw, 68px); line-height: 1.12; letter-spacing: -0.02em; color: var(--bz-text-primary); }
  h1 em { font-style: normal; color: var(--bz-accent-strong); }
  h2 { margin: 0 0 40px; font-weight: 800; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.2; letter-spacing: -0.01em; }
  .eyebrow { margin: 0 0 12px; font-size: 14px; font-weight: 600; color: var(--bz-accent-strong); }
  .eyebrow--on-dark { color: var(--bz-accent); }
  .pill { border-radius: 999px; }
  .soft { background: var(--bz-soft); }
  .dark { background: var(--bz-dark); color: #fff; }

  .hero { padding-top: 80px; padding-bottom: 88px; }
  .badge { display: inline-flex; gap: 8px; align-items: center; margin: 0 0 28px; padding: 6px 14px; border-radius: 999px; background: var(--bz-chip); color: var(--bz-accent-strong); font-size: 14px; font-weight: 500; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--bz-accent); }
  .hero__sub { margin: 28px 0 0; max-width: 640px; font-size: 19px; color: var(--bz-ink-700); }
  .jump { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 10px; }
  .jump a { display: inline-flex; gap: 10px; align-items: center; padding: 10px 18px; border: 1px solid var(--bz-border-subtle); border-radius: 999px; color: var(--bz-text-primary); font-weight: 600; text-decoration: none; transition: border-color 0.2s, background 0.2s; }
  .jump a:hover { border-color: var(--bz-accent); background: var(--bz-chip); }
  .jump span { font-size: 13px; color: var(--bz-accent-strong); }

  section[id] { scroll-margin-top: 72px; }
  .svc { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; align-items: start; }
  .svc__n { font-size: 14px; font-weight: 700; color: var(--bz-accent-strong); }
  .svc__head h2 { margin: 12px 0 20px; }
  .svc__lead { margin: 0; font-size: 18px; color: var(--bz-ink-700); }
  .items { display: grid; gap: 16px; }
  .item { background: var(--bz-bg-card); border: 1px solid var(--bz-border-subtle); border-radius: 20px; padding: 24px 28px; display: flex; flex-direction: column; gap: 8px; }
  .item h3 { margin: 0; font-size: 20px; font-weight: 800; }
  .item p { margin: 0; font-size: 15px; color: var(--bz-text-secondary); }
  .item__out { align-self: flex-start; margin-top: 6px; padding: 4px 12px; border-radius: 999px; background: var(--bz-chip); color: var(--bz-accent-strong); font-size: 13px; font-weight: 600; }

  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .step { background: var(--bz-dark-card); border-radius: 20px; padding: 28px; }
  .step__k { font-size: 13px; color: var(--bz-accent); font-weight: 700; }
  .step h3 { margin: 12px 0 8px; font-size: 22px; color: #fff; }
  .step p { margin: 0; font-size: 15px; color: var(--bz-on-dark-2); }

  .book-wrap { padding-top: 96px; padding-bottom: 96px; }
  .book { background: var(--bz-accent); color: var(--bz-on-accent); border-radius: 28px; padding: 64px 48px; display: flex; flex-wrap: wrap; gap: 32px; align-items: center; justify-content: space-between; }
  .book h2 { margin: 0; font-weight: 900; }
  .book p { margin: 16px 0 0; font-size: 18px; opacity: 0.8; }

  @media (max-width: 900px) {
    .svc { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  }
  @media (max-width: 767px) {
    .wrap { padding-left: 16px; padding-right: 16px; }
    .sec, .book-wrap { padding-top: 64px; padding-bottom: 64px; }
    .hero { padding-top: 48px; padding-bottom: 56px; }
    .book { padding: 40px 24px; }
  }
</style>
