---
import { Image } from 'astro:assets';
import mark from '../assets/baize-mark-v2.png';
import { localePath, withBase, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
  /** 对应语言版本的路径(不带 base);不传时切到对方语言的首页。 */
  switchPath?: string;
}

const { lang = 'zh-CN', switchPath } = Astro.props;
const isEnglish = lang === 'en';
const base = import.meta.env.BASE_URL; // 恒以 / 结尾
const href = (zhPath: string) => withBase(base, localePath(zhPath, lang));
// 路径带尾斜杠:构建产物是 services/index.html,少一个斜杠 CF/GH Pages 就会 308。
const NAV = [
  { path: '/services/', zh: '服务', en: 'Services' },
  { path: '/notes/', zh: '明理笔记', en: 'Notes' },
  { path: '/method/', zh: '方法论', en: 'Method' },
  { path: '/about/', zh: '关于白泽', en: 'About' },
];
const otherLang: Lang = isEnglish ? 'zh-CN' : 'en';
const switchHref = withBase(base, switchPath ?? localePath('/', otherLang));
---
<header class="hd">
  <div class="hd__inner">
    <a class="hd__brand" href={href('/')}>
      {/* eager:它在每页首屏,Astro 默认的 lazy 反而会拖慢它。 */}
      <Image class="hd__logo" src={mark} alt={isEnglish ? 'Baize AI' : '白泽明理'} width={99} height={126} loading="eager" />
      <span class="hd__wm">baize</span>
      {!isEnglish && <span class="hd__cn">白泽明理</span>}
    </a>
    <button class="hd__toggle" aria-label={isEnglish ? 'Menu' : '菜单'} aria-expanded="false">≡</button>
    <nav class="hd__nav" aria-label={isEnglish ? 'Main navigation' : '主导航'}>
      {NAV.map((n) => <a href={href(n.path)}>{isEnglish ? n.en : n.zh}</a>)}
      <a class="hd__lang" href={switchHref} hreflang={isEnglish ? 'zh-Hans' : 'en'} lang={otherLang}>{isEnglish ? '中文' : 'EN'}</a>
      <a class="hd__cta" href={href('/contact/')}>{isEnglish ? 'Book a call' : '预约咨询'}</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector('.hd__toggle');
  const nav = document.querySelector('.hd__nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--bz-border-subtle);
  }
  .hd__inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 12px 32px;
    display: flex;
    align-items: center;
    gap: 12px 40px;
  }
  .hd__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--bz-text-primary);
    text-decoration: none;
  }
  .hd__logo {
    width: 26px;
    height: auto;
  }
  .hd__wm {
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.01em;
  }
  .hd__cn {
    font-size: 14px;
    font-weight: 500;
    color: var(--bz-text-secondary);
  }
  .hd__nav {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .hd__nav a {
    color: var(--bz-ink-700);
    font-size: 15px;
    text-decoration: none;
  }
  .hd__nav a:hover {
    color: var(--bz-accent-strong);
  }
  .hd__nav .hd__lang {
    margin-left: auto;
    font-weight: 600;
  }
  .hd__nav .hd__cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--bz-ink-900);
    color: #fff;
    font-weight: 500;
  }
  .hd__nav .hd__cta:hover {
    background: var(--bz-dark);
    color: #fff;
  }
  .hd__toggle {
    display: none;
    margin-left: auto;
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--bz-border-subtle);
    border-radius: 999px;
    background: #fff;
    font-size: 20px;
    cursor: pointer;
  }
  @media (max-width: 767px) {
    .hd__inner {
      flex-wrap: wrap;
      padding: 10px 16px;
    }
    .hd__toggle {
      display: block;
    }
    .hd__nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      padding-bottom: 12px;
    }
    .hd__nav.is-open {
      display: flex;
    }
    .hd__nav a {
      min-height: 44px;
      display: flex;
      align-items: center;
    }
    .hd__nav .hd__lang {
      margin-left: 0;
    }
    .hd__nav .hd__cta {
      justify-content: center;
    }
  }
</style>
