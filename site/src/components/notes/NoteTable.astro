---
interface Props {
  columns: string[];
  rows: string[][];
  caption?: string;
}

const { columns, rows, caption } = Astro.props;
---

<div class="bz-note-table">
  <table>
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        {columns.map((column) => <th scope="col">{column}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell, index) => <td data-label={columns[index] ?? ''}>{cell}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .bz-note-table {
    margin: clamp(28px, 4vw, 40px) 0;
  }

  .bz-note-table table {
    width: 100%;
    margin: 0;
  }

  .bz-note-table caption {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .bz-note-table {
      border-top: 1px solid var(--bz-border-strong);
    }

    .bz-note-table table,
    .bz-note-table thead,
    .bz-note-table tbody,
    .bz-note-table tr,
    .bz-note-table th,
    .bz-note-table td {
      display: block;
      width: 100%;
      min-width: 0;
    }

    .bz-note-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }

    .bz-note-table tbody {
      display: grid;
      gap: 12px;
      background: transparent;
    }

    .bz-note-table tbody tr,
    .bz-note-table tbody tr:nth-child(even) {
      display: grid;
      gap: 0;
      padding: 4px 0;
      border: 1px solid var(--bz-border-subtle);
      background: var(--bz-bg-card);
    }

    .bz-note-table td,
    .bz-note-table td + td {
      display: grid;
      grid-template-columns: minmax(104px, 0.65fr) minmax(0, 1fr);
      gap: 12px;
      border: 0;
      border-bottom: 1px solid var(--bz-border-subtle);
      padding: 12px 14px;
    }

    .bz-note-table td:last-child {
      border-bottom: 0;
    }

    .bz-note-table td::before {
      content: attr(data-label);
      color: var(--bz-text-muted);
      font-family: var(--bz-font-mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.05em;
      line-height: 1.55;
      text-transform: uppercase;
    }

    .bz-note-table td:first-child {
      width: 100%;
      color: var(--bz-text-primary);
      font-weight: 650;
    }
  }
</style>
