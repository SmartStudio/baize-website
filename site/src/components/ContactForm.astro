---
---
<form class="bz-contact-form" id="contact-form">
  <div class="cf-head">
    <h2>预约 30 分钟免费诊断</h2>
    <p>告诉我们团队现状和最想解决的问题，我们判断适合从哪里开始。</p>
  </div>
  <div class="bz-field">
    <label for="cf-name">姓名</label>
    <input id="cf-name" name="name" autocomplete="name" required />
  </div>
  <div class="bz-field">
    <label for="cf-company">公司 / 团队</label>
    <input id="cf-company" name="company" autocomplete="organization" />
  </div>
  <div class="bz-field">
    <label for="cf-contact">联系方式</label>
    <input id="cf-contact" name="contact" autocomplete="email" required />
  </div>
  <div class="bz-field">
    <label for="cf-service">感兴趣的服务</label>
    <select id="cf-service" name="service">
      <option value="诊断">预约 AI 落地诊断</option>
      <option value="培训">企业培训合作</option>
      <option value="中转站/网关">中转站 / 网关服务咨询</option>
      <option value="Loop/交付">Loop / 端到端交付路径共创</option>
    </select>
  </div>
  <div class="bz-field">
    <label for="cf-problem">当前最想解决的问题</label>
    <textarea id="cf-problem" name="problem" required></textarea>
  </div>
  <input name="_hp" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
  <button class="bz-button bz-button--primary bz-button--lg cf-submit" type="submit">提交咨询需求</button>
  <p class="cf-status" data-status hidden aria-live="polite"></p>
</form>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = form?.querySelector('[data-status]') as HTMLParagraphElement | null;
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const API = import.meta.env.PUBLIC_FORM_ENDPOINT || '/api/contact';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    const body = Object.fromEntries(new FormData(form).entries());
    status.hidden = false;
    status.textContent = '提交中…';
    if (submitBtn) submitBtn.disabled = true;
    try {
      const r = await fetch(API, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });
      const j = await r.json();
      status.textContent = j.ok
        ? '已收到需求，我们会在 1-2 个工作日内联系你。'
        : '提交失败：' + (j.error || '请稍后重试');
      if (j.ok) form.reset();
    } catch {
      status.textContent = '网络异常，请稍后重试或直接邮件联系。';
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>

<style>
  .bz-contact-form {
    gap: 20px;
    border: 1px solid var(--bz-border-subtle);
    border-radius: 28px;
    padding: clamp(24px, 4vw, 44px);
  }
  .cf-head h2 {
    margin: 0;
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 800;
    line-height: 1.25;
  }
  .cf-head p {
    margin: 10px 0 4px;
    font-size: 15px;
    color: var(--bz-text-secondary);
  }
  .bz-contact-form :global(.bz-field input),
  .bz-contact-form :global(.bz-field select),
  .bz-contact-form :global(.bz-field textarea) {
    border-radius: 14px;
    border-color: var(--bz-border-subtle);
    background: var(--bz-soft);
    padding: 14px 16px;
    font-size: 15px;
  }
  .bz-contact-form :global(.bz-field textarea) {
    min-height: 140px;
  }
  .cf-submit {
    justify-self: start;
    border-radius: 999px;
  }
  .cf-status {
    margin: 0;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--bz-chip);
    color: var(--bz-accent-strong);
    font-size: 14px;
    font-weight: 600;
  }
  .cf-status[hidden] {
    display: none;
  }
</style>
