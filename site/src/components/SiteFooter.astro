---
import { Image } from 'astro:assets';
import qr from '../assets/wechat-qr.png';
import { localePath, withBase, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'zh-CN' } = Astro.props;
const isEnglish = lang === 'en';
const base = import.meta.env.BASE_URL;
const href = (zhPath: string) => withBase(base, localePath(zhPath, lang));
const year = new Date().getFullYear();
const SITE_LINKS = [
  { path: '/services/', zh: '服务', en: 'Services' },
  { path: '/method/', zh: '方法论', en: 'Method' },
  { path: '/about/', zh: '关于白泽', en: 'About' },
  { path: '/contact/', zh: '预约咨询', en: 'Contact' },
];
const RESOURCE_LINKS = [
  { path: '/notes/', zh: '明理笔记', en: 'Notes' },
  { path: '/rss.xml', zh: 'RSS', en: 'RSS' },
  { path: '/llms.txt', zh: 'llms.txt', en: 'llms.txt' },
];
---
<footer class="ft">
  <div class="ft__inner">
    <div class="ft__brand">
      {isEnglish ? <p class="ft__wm">baize</p> : <p class="ft__wm">baize <span>白泽明理</span></p>}
      <p>{isEnglish ? 'Remote-first AI transformation: consulting, training, forward deployed engineering.' : '企业 AI Native 转型：咨询、培训、FDE 驻场。'}</p>
      <!--email_off--><a href="mailto:contacts@fxai.ai">contacts@fxai.ai</a><!--/email_off-->
    </div>
    <div class="ft__col">
      <span class="ft__h">{isEnglish ? 'Site' : '站点'}</span>
      {SITE_LINKS.map((l) => <a href={href(l.path)}>{isEnglish ? l.en : l.zh}</a>)}
    </div>
    <div class="ft__col">
      <span class="ft__h">{isEnglish ? 'Resources' : '资源'}</span>
      {RESOURCE_LINKS.map((l) => <a href={href(l.path)}>{isEnglish ? l.en : l.zh}</a>)}
    </div>
    {!isEnglish && (
      <div class="ft__qr">
        <Image src={qr} alt="白泽明理微信二维码" format="png" quality={90} loading="lazy" />
        <span>微信扫码咨询</span>
      </div>
    )}
  </div>
  <p class="ft__meta">© {year} {isEnglish ? 'Baize Tech' : '白泽明理 Baize Tech'}</p>
</footer>
<style>
  .ft {
    background: var(--bz-dark);
    color: var(--bz-on-dark-muted);
    font-size: 14px;
  }
  .ft__inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 56px 32px 32px;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr auto;
    gap: 32px;
  }
  .ft a {
    color: var(--bz-on-dark-2);
    text-decoration: none;
  }
  .ft a:hover {
    color: var(--bz-accent);
  }
  .ft p {
    margin: 0 0 8px;
  }
  .ft__wm {
    font-size: 20px;
    font-weight: 800;
    color: #fff;
  }
  .ft__wm span {
    font-size: 14px;
    font-weight: 500;
    color: var(--bz-on-dark-muted);
  }
  .ft__col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ft__h {
    color: #fff;
    font-weight: 600;
  }
  .ft__qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 12px;
  }
  .ft__qr img {
    width: 96px;
    height: 96px;
    border-radius: 12px;
    background: #fff;
    padding: 6px;
  }
  .ft__meta {
    max-width: 1240px;
    margin: 0 auto;
    padding: 20px 32px 32px;
    border-top: 1px solid var(--bz-on-dark-line);
    font-size: 13px;
  }
  @media (max-width: 767px) {
    .ft__inner {
      grid-template-columns: 1fr 1fr;
      padding: 48px 16px 24px;
    }
    .ft__brand {
      grid-column: 1 / -1;
    }
    .ft__meta {
      padding: 20px 16px 28px;
    }
  }
</style>
