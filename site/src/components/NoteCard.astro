---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { categoryLabel } from '../lib/notes';
import { notePath, withBase } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: CollectionEntry<'notes'>['data']['category'];
  slug: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  lang?: 'zh-CN' | 'en';
}
const { title, description, pubDate, category, slug, cover, coverAlt, lang = 'zh-CN' } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = withBase(base, notePath(slug, lang));
const dateStr = pubDate.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-CN', {
  year: 'numeric',
  month: lang === 'en' ? 'short' : '2-digit',
  day: '2-digit',
});
const displayCategory = categoryLabel(category, lang);
---
<article class="note-card" data-category={category}>
  <a class="note-card__cover" href={href} tabindex="-1" aria-hidden="true">
    {cover && (
      <Image src={cover} alt={coverAlt ?? ''} widths={[320, 640]} sizes="(max-width: 640px) 100vw, 380px" class="note-card__img" />
    )}
    <span class="note-card__chip">{displayCategory}</span>
  </a>
  <div class="note-card__body">
    <p class="note-card__meta"><time datetime={pubDate.toISOString()}>{dateStr}</time></p>
    <h3 class="note-card__title"><a href={href}>{title}</a></h3>
    <p class="note-card__desc">{description}</p>
  </div>
</article>

<style>
  .note-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--bz-border-subtle);
    border-radius: 20px;
    background: var(--bz-bg-card);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .note-card[hidden] {
    display: none;
  }
  .note-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(10, 31, 28, 0.08);
  }
  .note-card__cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bz-soft);
  }
  .note-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .note-card__chip {
    position: absolute;
    left: 14px;
    bottom: 14px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--bz-white);
    color: var(--bz-text-primary);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
  }
  .note-card__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px 22px;
  }
  .note-card__meta {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--bz-accent-strong);
  }
  .note-card__title {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.45;
  }
  .note-card__title a {
    color: var(--bz-text-primary);
    text-decoration: none;
  }
  /* 整卡可点:标题链接的伪元素铺满卡片 */
  .note-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .note-card__title a:focus-visible {
    outline: none;
  }
  .note-card:has(.note-card__title a:focus-visible) {
    outline: 3px solid var(--bz-focus-ring);
    outline-offset: 2px;
  }
  .note-card__desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--bz-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .note-card,
    .note-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
