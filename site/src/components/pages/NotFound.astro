---
/**
 * 404 页主体,中英两个路由共用(/404、/en/404)。404 恒 noindex,不输出 hreflang。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localePath, withBase, type Lang } from '../../lib/i18n';
import type { NotFoundCopy } from '../../i18n/notFound';

interface Props {
  lang: Lang;
  copy: NotFoundCopy;
}

const { lang, copy: t } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (zhPath: string) => withBase(base, localePath(zhPath, lang));
---
<BaseLayout title={t.title} description={t.description} path={localePath('/404', lang)} noindex lang={lang}>
  <section class="wrap">
    <div class="nf">
      <p class="badge"><span class="dot"></span>404</p>
      <h1>{t.h1}</h1>
      <p class="nf__sub">{t.sub}</p>
      <div class="nf__actions">
        <a class="bz-button bz-button--primary bz-button--lg pill" href={href('/')}>{t.home}</a>
        <a class="bz-button bz-button--secondary bz-button--lg pill" href={href('/notes/')}>{t.notes}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .wrap { max-width: 1240px; margin: 0 auto; padding: 80px 32px 96px; }
  .nf { background: var(--bz-soft); border-radius: 28px; padding: clamp(40px, 7vw, 96px) clamp(24px, 6vw, 80px); min-height: 44vh; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
  .badge { display: inline-flex; gap: 8px; align-items: center; margin: 0 0 24px; padding: 6px 14px; border-radius: 999px; background: var(--bz-chip); color: var(--bz-accent-strong); font-size: 14px; font-weight: 600; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--bz-accent); }
  h1 { margin: 0; font-weight: 900; font-size: clamp(40px, 5vw, 68px); line-height: 1.12; letter-spacing: -0.02em; color: var(--bz-text-primary); }
  .nf__sub { margin: 20px 0 0; font-size: 19px; color: var(--bz-ink-700); }
  .nf__actions { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 12px; }
  .pill { border-radius: 999px; }
  @media (max-width: 767px) {
    .wrap { padding: 48px 16px 64px; }
  }
</style>
